# Local (no Docker): defaults to SQLite, zero setup required.
DATABASE_URL=sqlite:///./claims.db

# Docker Compose overrides this to point at the `db` service instead (see
# docker-compose.yml) — you don't need to set it yourself for Docker use.

# Optional: set this to use a real LLM instead of the offline stub in
# app/agents/llm_client.py. Leave unset and everything still runs.
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing. Leave both unset and every LLM call (stub or
# real) still runs identically — @traceable in llm_client.py becomes a true
# no-op. Set both to see every call's prompt/output/latency in LangSmith:
#   1. Sign up at https://smith.langchain.com, create a project, get an API key.
#   2. Set LANGCHAIN_TRACING_V2=true and LANGCHAIN_API_KEY below.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=claims-denial-appeal

# Search and embeddings (needs Postgres with pgvector, which docker compose gives you).
#   stub   = offline fake embeddings. Matches words, not meaning. Good for tests.
#   ollama = real embeddings. First run: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=stub
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
